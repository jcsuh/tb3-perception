<?xml version="1.0"?>
<!--
  Kalibr AprilGrid 6x4, tag 50 mm, spacing 0.3
  printed board 405 x 275 mm (incl. outer corner squares)
  model origin = Kalibr target origin (tag 0 bottom-left corner), x right, y up, z = front
  generated by tb3p_gazebo/scripts/make_aprilgrid_model.py
-->
<sdf version="1.9">
  <model name="aprilgrid_a3">
    <static>true</static>
    <link name="board">
      <visual name="print">
        <geometry>
          <mesh><uri>model://aprilgrid_a3/meshes/board.obj</uri></mesh>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <ambient>1 1 1 1</ambient>
          <emissive>0.6 0.6 0.6 1</emissive>
          <pbr>
            <metal>
              <albedo_map>model://aprilgrid_a3/materials/textures/board.png</albedo_map>
              <emissive_map>model://aprilgrid_a3/materials/textures/board.png</emissive_map>
              <metalness>0.0</metalness>
              <roughness>1.0</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
      <!-- foam board behind the print (5 mm) -->
      <visual name="backing">
        <pose>0.187500 0.122500 -0.0026 0 0 0</pose>
        <geometry><box><size>0.405000 0.275000 0.005</size></box></geometry>
        <material><diffuse>0.9 0.9 0.9 1</diffuse><ambient>0.9 0.9 0.9 1</ambient></material>
      </visual>
      <collision name="collision">
        <pose>0.187500 0.122500 -0.0026 0 0 0</pose>
        <geometry><box><size>0.405000 0.275000 0.005</size></box></geometry>
      </collision>
    </link>
  </model>
</sdf>
