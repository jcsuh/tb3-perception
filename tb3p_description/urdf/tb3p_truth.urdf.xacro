<?xml version="1.0"?>
<!--
  정답 모델(Gazebo, truth:=true) 전용 장치

  - OdometryPublisher: Gazebo가 아는 로봇의 실제 위치를 /truth/odom으로 발행 (채점용)
    world -> base_footprint, 50 Hz, 노이즈 없음
  - 추정기는 이 토픽을 구독하면 안 된다 (정답지). 읽어도 되는 것은 tb3p_eval뿐.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:if value="$(arg truth)">
    <gazebo>
      <plugin filename="gz-sim-odometry-publisher-system"
              name="gz::sim::systems::OdometryPublisher">
        <odom_frame>world</odom_frame>
        <robot_base_frame>base_footprint</robot_base_frame>
        <odom_topic>truth/odom</odom_topic>
        <tf_topic>truth/odom_tf</tf_topic>
        <odom_publish_frequency>50</odom_publish_frequency>
        <dimensions>3</dimensions>
      </plugin>
    </gazebo>
  </xacro:if>
</robot>
